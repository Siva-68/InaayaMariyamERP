// server/.env — DEVELOPMENT ONLY
// Generated from .env.example — do not commit this file
// See ../.env.example for full documentation of each variable

NODE_ENV=development
PORT=3001

# Replace with your replica-set MongoDB URI
# For local dev with Docker Compose: mongodb://127.0.0.1:27017/hinaya_mariyam_erp?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/hinaya_mariyam_erp?replicaSet=rs0

CORS_ORIGIN=http://localhost:5173

# Generate a real secret for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-secret-replace-before-production-deploy

SESSION_TTL_HOURS=8
TZ=Asia/Kolkata

INVOICE_PREFIX=HM
INVOICE_FORMAT=HM/YYYY/######

REPORT_CRON=0 21 * * *
REPORT_TIMEZONE=Asia/Kolkata
REPORT_OUTPUT_DIR=./reports

# Leave blank to disable integrations in development
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAIL_RECIPIENTS=sivaprakashs127@gmail.com

ADMIN_MOBILE=9698603288
ADMIN_EMAIL=sivaprakashs127@gmail.com

WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_RECIPIENT_NUMBER=
WA_TEMPLATE_NAME=

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

{
  "name": "hinaya-mariyam-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "import-catalogue": "ts-node-dev --transpile-only ../scripts/import-catalogue.ts",
    "backup": "ts-node-dev --transpile-only ../scripts/backup.ts",
    "restore": "ts-node-dev --transpile-only ../scripts/restore.ts",
    "test:endpoints": "ts-node-dev --transpile-only ../scripts/test-all-endpoints.ts"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "axios": "^1.7.9",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.15.2",
    "uuid": "^11.0.4",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}

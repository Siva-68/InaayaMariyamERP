# ============================================================
# HINAYA MARIYAM ERP — Environment Variables Reference
# ============================================================
# Copy this file to server/.env for local development.
# NEVER commit a real .env file. Add server/.env to .gitignore.
# ============================================================

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# A replica-set capable MongoDB URI is REQUIRED for transactions.
# Standalone MongoDB is not supported for Phase 3+ (billing).
#
# Local single-node replica set:
#   MONGODB_URI=mongodb://127.0.0.1:27017/hinaya_mariyam_erp?replicaSet=rs0
#
# MongoDB Atlas:
#   MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hinaya_mariyam_erp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/hinaya_mariyam_erp?replicaSet=rs0

# ----------------------------------------------------------
# App Server
# ----------------------------------------------------------
NODE_ENV=development
PORT=3001

# Comma-separated allowed CORS origins (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------
# Session
# ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_32_CHARS_MIN

# Session TTL in hours (default 8)
SESSION_TTL_HOURS=8

# ----------------------------------------------------------
# Timezone
# ----------------------------------------------------------
TZ=Asia/Kolkata

# ----------------------------------------------------------
# Invoice Settings (overridden by DB settings; these are defaults)
# ----------------------------------------------------------
INVOICE_PREFIX=HM
# Format tokens: HM/YYYY/######  (# = zero-padded number)
INVOICE_FORMAT=HM/YYYY/######

# ----------------------------------------------------------
# Report Schedule
# ----------------------------------------------------------
# Cron expression (default: 9:00 PM Asia/Kolkata every day)
REPORT_CRON=0 21 * * *
REPORT_TIMEZONE=Asia/Kolkata

# Directory to store generated report PDFs (relative to server/)
REPORT_OUTPUT_DIR=./reports

# ----------------------------------------------------------
# Email Delivery (optional — leave blank to disable)
# ----------------------------------------------------------
# Integration is DISABLED when SMTP_HOST is empty.
# Never claim delivery occurred without provider confirmation.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated recipient email addresses
REPORT_EMAIL_RECIPIENTS=

# ----------------------------------------------------------
# WhatsApp Business Cloud API (optional — leave blank to disable)
# ----------------------------------------------------------
# MUST use official Meta WhatsApp Business Cloud API only.
# Unofficial automation is strictly prohibited.
# Integration is DISABLED when WA_PHONE_NUMBER_ID is empty.
#
# Setup guide: docs/WHATSAPP_SETUP.md (created in Phase 6)
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
# Recipient WhatsApp number in international format e.g. 919876543210
WA_RECIPIENT_NUMBER=
# Pre-approved Meta message template name for document delivery
WA_TEMPLATE_NAME=

# ----------------------------------------------------------
# Backup Storage (optional — configure before production)
# ----------------------------------------------------------
# Leave blank to use local filesystem only
BACKUP_DIR=./backups
# S3-compatible endpoint (optional)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Retention in days
BACKUP_RETENTION_DAYS=30
